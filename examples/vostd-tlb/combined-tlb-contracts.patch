+    pub open spec fn flush_range(self, range: Range<Vaddr>) -> Self {
+        let m = self.mappings.filter(|m: Mapping| m.va_range.start < range.end && range.start < m.va_range.end);
+        TlbModel { pending: self.pending, mappings: self.mappings - m }
+    }
+
+    pub open spec fn apply_op(mappings: Set<Mapping>, op: TlbFlushOp) -> Set<Mapping> {
+        match op {
+            TlbFlushOp::All => Set::<Mapping>::empty(),
+            TlbFlushOp::Address(va) => mappings.filter(|m: Mapping| !(m.va_range.start <= va < m.va_range.end)),
+            TlbFlushOp::Range(range) => mappings.filter(|m: Mapping| !(m.va_range.start < range.end && range.start < m.va_range.end)),
+        }
+    }
+
+    pub open spec fn apply_all(mappings: Set<Mapping>, pending: Seq<TlbFlushOp>) -> Set<Mapping>
+        decreases pending.len(),
+    {
+        if pending.len() == 0 {
+            mappings
+        } else {
+            TlbModel::apply_all(Self::apply_op(mappings, pending[0]), pending[1..])
+        }
+    }
+
+    pub open spec fn op_covers(op: TlbFlushOp, m: Mapping) -> bool {
+        match op {
+            TlbFlushOp::All => true,
+            TlbFlushOp::Address(va) => m.va_range.start <= va < m.va_range.end,
+            TlbFlushOp::Range(range) => m.va_range.start < range.end && range.start < m.va_range.end,
+        }
+    }
