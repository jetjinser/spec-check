{
  "target_workspace": {
    "manifest_path": "/tmp/vostd-43da079-ktest-chan/Cargo.toml",
    "inject_dir": "ostd/src/spec_check_probes",
    "gate_cfg": "ktest",
    "extra_cfgs": [
      "ktest_capture_gap"
    ],
    "target": "x86_64-unknown-none"
  },
  "types": {
    "LinkedList": {
      "imports": [
        "use crate::mm::frame::linked_list::LinkedList;",
        "use crate::specs::mm::frame::meta_owners::MetaSlotStorage;"
      ],
      "construct": "LinkedList::<MetaSlotStorage>::new()"
    },
    "LinkStorage": {
      "imports": [
        "use crate::mm::frame::linked_list::Link;",
        "use crate::specs::mm::frame::meta_owners::MetaSlotStorage;"
      ],
      "construct": "Link::<MetaSlotStorage>::new(MetaSlotStorage::Untyped)"
    }
  },
  "interfaces": {
    "LinkedList<M>::new": {
      "receiver_type": "LinkedList",
      "family": "value-readback",
      "call": "{recv}.is_empty()",
      "assert": "{out}"
    },
    "<Link<M> as Deref>::deref": {
      "receiver_type": "LinkStorage",
      "family": "value-readback",
      "call": "&*{recv}",
      "assert": "*{out} is Untyped"
    }
  }
}
