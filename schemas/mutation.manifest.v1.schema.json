{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-check.dev/schemas/mutation.manifest.v1.schema.json",
  "title": "spec-check mutation manifest",
  "type": "object",
  "required": [
    "schema_version",
    "target_workspace",
    "source",
    "package",
    "module",
    "target_dir",
    "full_confirm",
    "mutations"
  ],
  "properties": {
    "schema_version": { "const": "mutation.manifest.v1" },
    "target_workspace": { "type": "string" },
    "source": { "type": "string" },
    "package": { "type": "string" },
    "module": { "type": "string" },
    "target": { "type": ["string", "null"] },
    "target_dir": { "type": "string" },
    "full_confirm": { "type": "boolean" },
    "full_target_dir": { "type": ["string", "null"] },
    "timeout_seconds": { "type": "integer", "minimum": 1 },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "old", "new"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "old": { "type": "string", "minLength": 1 },
          "new": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
