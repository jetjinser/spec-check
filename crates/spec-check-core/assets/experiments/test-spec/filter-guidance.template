vstd::prelude::verus! {
proof fn __spec_filter_laws<I: Iterator + vstd::std_specs::iter::IteratorSpec, P: FnMut(&I::Item) -> bool>(base: I, predicate: P, iter: core::iter::Filter<I, P>)
